# Copy to api/.env on the server (never commit real secrets)

APP_KEY=change-me-to-a-long-random-string
APP_DEBUG=false
ALLOW_SETUP=false
FORCE_SECURE_COOKIES=true
TRUSTED_PROXY=true
ALLOWED_ORIGIN=https://kisisel.serkanylmz.com.tr

# Temporary bootstrap (auto-creates first admin if DB empty). Remove after go-live.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Admin123!temp

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_db_user
DB_PASS=your_db_password

IP_HASH_PEPPER=another-long-random-string
TOTP_ISSUER=SerkanYilmaz Analytics

SESSION_IDLE_SEC=1800
SESSION_ABSOLUTE_SEC=28800

LOGIN_RATE_WINDOW_SEC=900
LOGIN_RATE_MAX_IP=20
LOGIN_RATE_MAX_USER=10

ONLINE_WINDOW_SEC=60
ANALYTICS_RATE_MAX_PER_MIN=120

RETENTION_PAGEVIEWS_DAYS=90
RETENTION_SESSIONS_DAYS=180
RETENTION_AUTH_DAYS=30
RETENTION_AUDIT_DAYS=180

CLEANUP_TOKEN=change-me-cleanup-token

# Optional MaxMind GeoLite2-City.mmdb path (leave empty to use CF country / Unknown)
GEOLITE2_PATH=
