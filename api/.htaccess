# Analytics API — Apache rules (cPanel-safe)
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<Files ".env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

<Files "schema.sql">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # Deny direct access to lib/ and scripts/
  RewriteRule ^(lib|scripts)/ - [F,L]

  # Front controller (existing files like ping.php still served directly)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
</IfModule>
